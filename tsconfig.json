{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "/static/wasm/map_wasm.js": ["./static/wasm/map_wasm.d.ts"]
    }
  },
  "include": ["client/**/*.ts"],
  "exclude": ["static/wasm"]
}
